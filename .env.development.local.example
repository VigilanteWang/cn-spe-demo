# Development environment template
# Copy this file to .env.development.local before local development.
# 真正需要手动填写的主要是：
# - CLOUD_ENV
# - API_ENTRA_APP_CLIENT_ID
# - API_ENTRA_APP_CLIENT_SECRET
# - API_ENTRA_APP_TENANT_ID
# - CONTAINER_TYPE_ID
# - VITE_CLIENT_ENTRA_APP_CLIENT_ID
# 其余变量大多是本地默认值，或由上面的值派生得到。
# 变量完整解释见仓库根目录 .env.example。

# 云环境：商业云填 global；世纪互联 / 21Vianet 填 china。
CLOUD_ENV=global
VITE_CLOUD_ENV=$CLOUD_ENV

# backend 应用（服务端私有配置，需要手填）
API_ENTRA_APP_CLIENT_ID=<your-api-entra-app-client-id>
API_ENTRA_APP_CLIENT_SECRET=<your-api-entra-app-client-secret>
API_ENTRA_APP_TENANT_ID=<your-tenant-id>
CONTAINER_TYPE_ID=<your-container-type-id>

# 本地开发默认允许 Vite 前端从 http://localhost:3000 调后端。
CORS_ALLOWED_ORIGINS=http://localhost:3000

# frontend 应用（浏览器可见变量）
VITE_CLIENT_ENTRA_APP_CLIENT_ID=<your-client-entra-app-client-id>
# 默认直接复用后端同一个 tenant，无需单独改。
VITE_CLIENT_ENTRA_APP_TENANT_ID=$API_ENTRA_APP_TENANT_ID
# 前端请求后端 API token 时会用到 backend app id，默认直接复用上面的值。
VITE_API_ENTRA_APP_CLIENT_ID=$API_ENTRA_APP_CLIENT_ID
# 本地后端默认跑在 3001，无需改。
VITE_API_SERVER_URL=http://localhost:3001
